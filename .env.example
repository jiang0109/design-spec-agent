# ============================================================
# 复制本文件为 .env，然后填入你自己的 API key
#     Windows:  copy .env.example .env
#     macOS/Linux:  cp .env.example .env
#
# .env 已在 .gitignore 里，**不会被提交到 GitHub**。
# 永远不要把 key 写进代码、写进 README、或截图发出去。
# ============================================================

# --- 必填：你的 API key ---
# DeepSeek: https://platform.deepseek.com  →  API Keys
# OpenAI  : https://platform.openai.com/api-keys
LLM_API_KEY=在这里粘贴你的密钥

# --- 接口地址 ---
# DeepSeek 官方：
LLM_BASE_URL=https://api.deepseek.com
# 如果用 OpenAI，改成 https://api.openai.com/v1
# 如果用通义/智谱/月之暗面等兼容接口，填它们各自的 base_url

# --- 模型名 ---
LLM_MODEL=deepseek-chat
# OpenAI 可用 gpt-4o-mini；DeepSeek 也可用 deepseek-reasoner（更贵、更慢）

# --- 可选：单次请求超时（秒）---
LLM_TIMEOUT=120
